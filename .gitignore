# Ignora todo
*

# No ignores archivos específicos
!.vimrc
!.ideavimrc
!vimNotes.txt
!vimNotes.md
!README.md
!WORKFLOW.md
!COURSE.md
!COURSE.pdf
!UDEMY.md
!course/
!course/**
!AGENTS.md
!LICENSE
!COPYRIGHT
!.gitignore
!.github/
!.github/workflows/
!.github/workflows/**

# CAPDESIS Practice (Flutter desktop)
!trainer/
!trainer/**
trainer/.dart_tool/
trainer/build/
trainer/.idea/
trainer/**/ephemeral/

# Neovim config
!.config/
!.config/nvim/
!.config/nvim/**

# Ignorar plugins clonados (packer, plug, etc.)
.config/nvim/pack/
.config/nvim/plugin/packer_compiled.lua

# Working documentation files (not part of config)
.config/nvim/*.md
!.config/nvim/README.md

# Archivos basura del sistema
*.DS_Store
Thumbs.db
.directory

# Archivos con datos sensibles - NUNCA commitear
.zshrc
.bashrc
.bash_profile
.zprofile
.env
.env.*
.envrc
*.key
*.pem
*_rsa
*_dsa
secrets*
credentials*

# Vim state files con historial de paths
.vim/.netrwhist
.viminfo

# Plugin lock files (regenerables)
.config/nvim/lazy-lock.json
