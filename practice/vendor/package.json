{
  "name": "practice-vendor",
  "private": true,
  "description": "Builds codemirror.js: one bundle so the page loads a single copy of @codemirror/state.",
  "scripts": {
    "build": "bun build entry.js --format=esm --minify --outfile=codemirror.js"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "@replit/codemirror-vim": "6.4.0"
  }
}
