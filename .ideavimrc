" ~/.ideavimrc — JetBrains IdeaVim (IntelliJ / Android Studio / …)
" Docs: https://github.com/JetBrains/ideavim
" Install: Settings | Plugins → IdeaVim, then Tools | Vim
" Reload: :source ~/.ideavimrc
" Find action IDs: :actionlist <pattern>  or  "IdeaVim: track action IDs"
"
" Mappings to IDE actions MUST use <Action>(id) with map/nmap (NOT nnoremap,
" NOT :action in a mapping). Official: noremap does not work with <Action>.
"
" Shared with Neovim: leader = Space, same prefixes (f* find, g* git, fl* flutter,
" x* diagnostics, m* marks, b* buffers, w* windows, t* terminal, r* run, d* debug).
" Neovim-only: <leader>a* AI CLIs, <leader>c* CopilotChat.

let mapleader = " "

" -----------------------------------------------------------------------------
" Options (supported: https://github.com/JetBrains/ideavim/wiki/set-commands)
" -----------------------------------------------------------------------------
set number
set relativenumber
set tabstop=4
set shiftwidth=4
set expandtab
set smartindent
set scrolloff=8
set cursorline
set colorcolumn=80
set clipboard=unnamedplus,ideaput
set showcmd
set showmode
set timeoutlen=300
set splitright
set splitbelow
set nowrap
set incsearch
set hlsearch
set ignorecase
set smartcase

set ideajoin
set ideamarks
set idearefactormode=keep
set ideastatusicon=gray

" Built-in IdeaVim extensions (no extra Marketplace plugins)
set surround
set commentary
set highlightedyank
set textobj-entire
set argtextobj
set ReplaceWithRegister
set NERDTree

" -----------------------------------------------------------------------------
" Vim-native maps (not IDE actions) — nnoremap is OK here
" -----------------------------------------------------------------------------
nnoremap <leader><leader> :nohl<CR>
inoremap jj <Esc>

nnoremap n nzz
nnoremap N Nzz
nnoremap * *zz
nnoremap # #zz
nnoremap g* g*zz
nnoremap g# g#zz

vnoremap > >gv
vnoremap < <gv
vnoremap <leader>u gu
vnoremap <leader>U gU

nnoremap <A-j> :m .+1<CR>==
nnoremap <A-k> :m .-2<CR>==
vnoremap <A-j> :m '>+1<CR>gv=gv
vnoremap <A-k> :m '<-2<CR>gv=gv

nnoremap <leader>wh <C-w>h
nnoremap <leader>wj <C-w>j
nnoremap <leader>wk <C-w>k
nnoremap <leader>wl <C-w>l

" Harpoon-like: Vim marks 1-9 (same keys as Neovim harpoon)
nnoremap <leader>1 '1
nnoremap <leader>2 '2
nnoremap <leader>3 '3
nnoremap <leader>4 '4
nnoremap <leader>5 '5
nnoremap <leader>6 '6
nnoremap <leader>7 '7
nnoremap <leader>8 '8
nnoremap <leader>9 '9

" -----------------------------------------------------------------------------
" IDE actions — nmap + <Action>(id)  (stock IntelliJ Platform IDs)
" -----------------------------------------------------------------------------

" Navigation history (same keys as Neovim vim-options.lua)
nmap <leader>b <Action>(Back)
nmap <leader>f <Action>(Forward)

" Find (Telescope equivalents)
nmap <leader>ff <Action>(GotoFile)
nmap <leader>fg <Action>(FindInPath)
nmap <leader>fo <Action>(RecentFiles)
nmap <leader>fb <Action>(Switcher)
nmap <leader>fh <Action>(HelpTopics)
nmap <leader>fc <Action>(GotoAction)
nmap <leader>fk <Action>(GotoAction)
nmap <leader>ps <Action>(GotoSymbol)
nmap <leader>. <Action>(GotoFile)
nmap ,, <Action>(GotoFile)
nmap <leader>fp <Action>(ManageRecentProjects)

" Project / files (neo-tree / oil equivalents)
nmap <leader>pv <Action>(ActivateProjectToolWindow)
nmap <leader>pe <Action>(ActivateProjectToolWindow)
nmap <leader>pf <Action>(ActivateProjectToolWindow)
nmap <leader>fr <Action>(SelectInProjectView)
nmap <leader>- <Action>(ActivateProjectToolWindow)
nmap <leader>oe <Action>(ActivateProjectToolWindow)
nmap <leader>tb <Action>(FileStructurePopup)
nmap <leader>bf <Action>(Switcher)

" Bookmarks (harpoon UI equivalents)
nmap <leader>mh <Action>(ShowBookmarks)
nmap <leader>ma <Action>(ToggleBookmark)
nmap <leader>mp <Action>(GotoPreviousBookmark)
nmap <leader>mn <Action>(GotoNextBookmark)

" Buffers / tabs
nmap <S-l> <Action>(NextTab)
nmap <S-h> <Action>(PreviousTab)
nmap <leader>bn <Action>(NextTab)
nmap <leader>bp <Action>(PreviousTab)
nmap <leader>bd <Action>(CloseContent)
nmap <leader>bl <Action>(CloseAllEditorsToTheRight)
nmap <leader>bh <Action>(CloseAllEditorsToTheLeft)
nmap <leader>to <Action>(CloseAllEditorsButActive)

" Terminal
nmap <leader>tt <Action>(ActivateTerminalToolWindow)

" Git (stock VCS — not Neovim plugins)
nmap <leader>gs <Action>(ActivateVersionControlToolWindow)
nmap <leader>gc <Action>(CheckinProject)
nmap <leader>gp <Action>(Vcs.Push)
nmap <leader>gl <Action>(Vcs.UpdateProject)
nmap <leader>gf <Action>(Git.Fetch)
nmap <leader>gh <Action>(Vcs.ShowTabbedFileHistory)
nmap <leader>ghd <Action>(Vcs.ShowTabbedFileHistory)
nmap <leader>gb <Action>(Annotate)
nmap <leader>gbl <Action>(Annotate)
nmap <leader>gbt <Action>(Annotate)
nmap <leader>gbr <Action>(Git.Branches)
nmap <leader>gd <Action>(Compare.SameVersion)
nmap <leader>gdo <Action>(Compare.LastVersion)
nmap <leader>gdq <Action>(CloseContent)
nmap <leader>gdh <Action>(Vcs.ShowTabbedFileHistory)
nmap <leader>gdf <Action>(ActivateVersionControlToolWindow)
nmap <leader>gn <Action>(VcsShowNextChangeMarker)
nmap <leader>gnp <Action>(VcsShowPrevChangeMarker)
nmap <leader>gsa <Action>(Git.Add)
nmap <leader>gsr <Action>(Vcs.RollbackChangedLines)
nmap <leader>gsu <Action>(Vcs.RollbackChangedLines)
nmap <leader>gsb <Action>(ChangesView.Revert)
nmap <leader>gsp <Action>(VcsShowCurrentChangeMarker)
nmap <leader>u <Action>(LocalHistory.ShowHistory)

" LSP / code (IDE inspections — not neovim lspconfig)
nmap K <Action>(ShowHoverInfo)
nmap gd <Action>(GotoDeclaration)
nmap gi <Action>(GotoImplementation)
nmap go <Action>(GotoTypeDeclaration)
nmap gr <Action>(FindUsages)
nmap gR <Action>(FindUsages)
nmap gs <Action>(ParameterInfo)
nmap <leader>ca <Action>(ShowIntentionActions)
nmap <leader>fm <Action>(ReformatCode)
nmap <leader>rn <Action>(RenameElement)

" Diagnostics (Trouble equivalents)
nmap <leader>xx <Action>(ActivateProblemsViewToolWindow)
nmap <leader>xX <Action>(ActivateProblemsViewToolWindow)
nmap <leader>xw <Action>(ActivateProblemsViewToolWindow)
nmap <leader>xd <Action>(ActivateProblemsViewToolWindow)
nmap <leader>xl <Action>(ActivateProblemsViewToolWindow)
nmap <leader>xq <Action>(ActivateProblemsViewToolWindow)
nmap <leader>xn <Action>(GotoNextError)
nmap <leader>xp <Action>(GotoPreviousError)

" Folding
nmap <leader>za <Action>(ExpandCollapseToggle)
nmap <leader>zR <Action>(ExpandAllRegions)
nmap <leader>zM <Action>(CollapseAllRegions)
nmap <leader>zr <Action>(ExpandRegion)
nmap <leader>zm <Action>(CollapseRegion)
nmap <leader>zz <Action>(ToggleDistractionFreeMode)

" Run / debug
nmap <leader>r <Action>(Run)
nmap <leader>rr <Action>(RunClass)
nmap <leader>rf <Action>(RunClass)
nmap <leader>rs <Action>(Stop)
nmap <leader>rp <Action>(Run)
nmap <leader>rb <Action>(Synchronize)
nmap <leader>db <Action>(ToggleLineBreakpoint)
nmap <leader>dB <Action>(EditBreakpoint)
nmap <leader>dc <Action>(Resume)
nmap <leader>do <Action>(StepOver)
nmap <leader>di <Action>(StepInto)
nmap <leader>dO <Action>(StepOut)
nmap <leader>dr <Action>(EvaluateExpression)
nmap <leader>dl <Action>(Debug)
nmap <leader>dx <Action>(Stop)
nmap <leader>du <Action>(ActivateDebugToolWindow)

" Tasks (overseer equivalents)
nmap <leader>oo <Action>(ActivateRunToolWindow)
nmap <leader>or <Action>(RunAnything)
nmap <leader>ob <Action>(CompileDirty)
nmap <leader>oi <Action>(editRunConfigurations)

" Tests
nmap <leader>ten <Action>(RunClass)
nmap <leader>tenf <Action>(RunClass)
nmap <leader>tena <Action>(RunAll)
nmap <leader>tenl <Action>(Rerun)

" Splits
nmap <leader>sv <Action>(SplitVertically)
nmap <leader>sh <Action>(SplitHorizontally)
nmap <leader>sc <Action>(Unsplit)
nmap <leader>so <Action>(UnsplitAll)

" Flutter — IDs from flutter-intellij plugin.xml (needs Flutter plugin)
" If missing: :actionlist flutter
if &ide =~? 'android' || &ide =~? 'intellij' || &ide =~? 'studio'
  nmap <leader>flr <Action>(Flutter.Toolbar.ReloadAction)
  nmap <leader>fls <Action>(Flutter.Toolbar.RestartAction)
  nmap <leader>fld <Action>(io.flutter.OpenDevToolsAction)
  nmap <leader>fla <Action>(Run)
  nmap <leader>flsd <Action>(Flutter.DeviceSelector)
  nmap <leader>flq <Action>(Stop)
  nmap <leader>flo <Action>(FileStructurePopup)
endif

" Location on disk:
"   All OS: ~/.ideavimrc  (Windows: %USERPROFILE%\.ideavimrc)
" Do not source ~/.vimrc from here (that file is classic Vim + vim-plug).
